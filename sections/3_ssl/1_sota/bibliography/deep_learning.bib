@article{tan_sound_2021,
	title = {Sound Source Localization Using a Convolutional Neural Network and Regression Model},
	volume = {21},
	issn = {1424-8220},
	doi = {10.3390/s21238031},
	abstract = {In this research, a novel sound source localization model is introduced that integrates a convolutional neural network with a regression model ({CNN}-R) to estimate the sound source angle and distance based on the acoustic characteristics of the interaural phase difference ({IPD}). The {IPD} features of the sound signal are firstly extracted from time-frequency domain by short-time Fourier transform ({STFT}). Then, the {IPD} features map is fed to the {CNN}-R model as an image for sound source localization. The Pyroomacoustics platform and the multichannel impulse response database ({MIRD}) are used to generate both simulated and real room impulse response ({RIR}) datasets. The experimental results show that an average accuracy of 98.96\% and 98.31\% are achieved by the proposed {CNN}-R for angle and distance estimations in the simulation scenario at {SNR} = 30 {dB} and {RT}60 = 0.16 s, respectively. Moreover, in the real environment, the average accuracies of the angle and distance estimations are 99.85\% and 99.38\% at {SNR} = 30 {dB} and {RT}60 = 0.16 s, respectively. The performance obtained in both scenarios is superior to that of existing models, indicating the potential of the proposed {CNN}-R model for real-life applications.},
	pages = {8031},
	number = {23},
	journaltitle = {Sensors (Basel, Switzerland)},
	shortjournal = {Sensors (Basel)},
	author = {Tan, Tan-Hsu and Lin, Yu-Tang and Chang, Yang-Lang and Alkhaleefah, Mohammad},
	date = {2021-12-01},
	pmid = {34884042},
	pmcid = {PMC8659937},
	keywords = {deep learning, sound source localization, Computer Simulation, convolutional neural network, Databases, Factual, Neural Networks, Computer, regression model, Sound, man, printed},
	file = {Full Text:/home/gaetan/.local/share/Zotero/storage/ELSCM4ES/Tan et al. - 2021 - Sound Source Localization Using a Convolutional Ne.pdf:application/pdf},
