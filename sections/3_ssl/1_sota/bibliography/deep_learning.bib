	url = {https://doi.org/10.1186/s13634-019-0604-x},
	doi = {10.1186/s13634-019-0604-x},
	abstract = {Head-related impulse responses ({HRIRs}) allow for the creation of virtual acoustic scenes. Since in ideal conditions the human auditory system can localize sounds with a very high degree of accuracy, it is useful to have an {HRIR} database with high spatial resolution, such that realistic-sounding scenes can be created. In this article, we present an {HRIR} database with 12722 directions, giving a spatial resolution of 2 arc degree or better, for a sphere covering − 64∘ elevation to the zenith. Four sets of {HRIRs} were recorded with different head-and-torso simulators ({HATSs}), including one with a six-channel bilateral behind-the-ear hearing aid model. The resulting database is available at https://www.uni-oldenburg.de/akustik/mmhr-hrtfand is distributed under a Creative Commons license.},
	pages = {9},
	number = {1},
	journaltitle = {{EURASIP} Journal on Advances in Signal Processing},
	shortjournal = {{EURASIP} Journal on Advances in Signal Processing},
	author = {Thiemann, Joachim and van de Par, Steven},
	urldate = {2025-01-25},
	date = {2019-02-13},
	keywords = {Auditory virtualization, Head-related impulse responses, Head-related transfer functions, Hearing aid},
	file = {Full Text PDF:/home/gaetan/.local/share/Zotero/storage/T8EZDK8T/Thiemann and van de Par - 2019 - A multiple model high-resolution head-related impulse response database for aided and unaided ears.pdf:application/pdf;Snapshot:/home/gaetan/.local/share/Zotero/storage/NDILP4WF/s13634-019-0604-x.html:text/html},
}


@misc{mesaros_decade_2024,
	title = {A decade of {DCASE}: Achievements, practices, evaluations and future challenges},
	url = {http://arxiv.org/abs/2410.04951},
	doi = {10.48550/arXiv.2410.04951},
	shorttitle = {A decade of {DCASE}},
	abstract = {This paper introduces briefly the history and growth of the Detection and Classification of Acoustic Scenes and Events ({DCASE}) challenge, workshop, research area and research community. Created in 2013 as a data evaluation challenge, {DCASE} has become a major research topic in the Audio and Acoustic Signal Processing area. Its success comes from a combination of factors: the challenge offers a large variety of tasks that are renewed each year; and the workshop offers a channel for dissemination of related work, engaging a young and dynamic community. At the same time, {DCASE} faces its own challenges, growing and expanding to different areas. One of the core principles of {DCASE} is open science and reproducibility: publicly available datasets, baseline systems, technical reports and workshop publications. While the {DCASE} challenge and workshop are independent of {IEEE} {SPS}, the challenge receives annual endorsement from the {AASP} {TC}, and the {DCASE} community contributes significantly to the {ICASSP} flagship conference and the success of {SPS} in many of its activities.},
	number = {{arXiv}:2410.04951},
	publisher = {{arXiv}},
	author = {Mesaros, Annamaria and Serizel, Romain and Heittola, Toni and Virtanen, Tuomas and Plumbley, Mark D.},
	urldate = {2025-01-25},
	date = {2024-10-07},
	eprinttype = {arxiv},
	eprint = {2410.04951 [eess]},
	keywords = {Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Preprint PDF:/home/gaetan/.local/share/Zotero/storage/5CKUYZF9/Mesaros et al. - 2024 - A decade of DCASE Achievements, practices, evaluations and future challenges.pdf:application/pdf;Snapshot:/home/gaetan/.local/share/Zotero/storage/AK3HLV63/2410.html:text/html},
