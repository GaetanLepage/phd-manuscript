}


# (Deleforge) + info on ISM
@misc{srivastava_how_2023,
	title = {How to (virtually) train your speaker localizer},
	url = {http://arxiv.org/abs/2211.16958},
	doi = {10.48550/arXiv.2211.16958},
	abstract = {Learning-based methods have become ubiquitous in speaker localization. Existing systems rely on simulated training sets for the lack of sufficiently large, diverse and annotated real datasets. Most room acoustics simulators used for this purpose rely on the image source method ({ISM}) because of its computational efficiency. This paper argues that carefully extending the {ISM} to incorporate more realistic surface, source and microphone responses into training sets can significantly boost the real-world performance of speaker localization systems. It is shown that increasing the training-set realism of a state-of-the-art direction-of-arrival estimator yields consistent improvements across three different real test sets featuring human speakers in a variety of rooms and various microphone arrays. An ablation study further reveals that every added layer of realism contributes positively to these improvements.},
	number = {{arXiv}:2211.16958},
	publisher = {{arXiv}},
	author = {Srivastava, Prerak and Deleforge, Antoine and Politis, Archontis and Vincent, Emmanuel},
	urldate = {2023-10-23},
	date = {2023-05-25},
	eprinttype = {arxiv},
	eprint = {2211.16958 [cs, eess]},
	keywords = {Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {arXiv Fulltext PDF:/home/gaetan/.local/share/Zotero/storage/CXXU2XSZ/Srivastava et al. - 2023 - How to (virtually) train your speaker localizer.pdf:application/pdf;arXiv.org Snapshot:/home/gaetan/.local/share/Zotero/storage/LADLFRA9/2211.html:text/html},
}

@article{yalta_sound_2017,
	title = {Sound Source Localization Using Deep Learning Models},
	volume = {29},
	issn = {1883-8049, 0915-3942},
	url = {https://www.fujipress.jp/jrm/rb/robot002900010037},
	doi = {10.20965/jrm.2017.p0037},
	abstract = {This study proposes the use of a deep neural network to localize a sound source using an array of microphones in a reverberant environment. During the last few years, applications based on deep neural networks have performed various tasks such as image classiﬁcation or speech recognition to levels that exceed even human capabilities. In our study, we employ deep residual networks, which have recently shown remarkable performance in image classiﬁcation tasks even when the training period is shorter than that of other models. Deep residual networks are used to process audio input similar to multiple signal classiﬁcation ({MUSIC}) methods. We show that with end-to-end training and generic preprocessing, the performance of deep residual networks not only surpasses the block level accuracy of linear models on nearly clean environments but also shows robustness to challenging conditions by exploiting the time delay on power information.},
	pages = {37--48},
	number = {1},
	journaltitle = {Journal of Robotics and Mechatronics},
	shortjournal = {J. Robot. Mechatron.},
	author = {Yalta, Nelson and Nakadai, Kazuhiro and Ogata, Tetsuya and {Intermedia Art and Science Department, Waseda University} and {Honda Research Institute Japan Co., Ltd.}},
	urldate = {2022-06-08},
	date = {2017-02-20},
	langid = {english},
	file = {Yalta et al. - 2017 - Sound Source Localization Using Deep Learning Mode.pdf:/home/gaetan/.local/share/Zotero/storage/QPYMJJ2I/Yalta et al. - 2017 - Sound Source Localization Using Deep Learning Mode.pdf:application/pdf},
}


@article{hu_sound_2023,
	title = {Sound source localization based on residual network and channel attention module},
	volume = {13},
	rights = {2023 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-023-32657-7},
	doi = {10.1038/s41598-023-32657-7},
	abstract = {This paper presents a sound source localization ({SSL}) model based on residual network and channel attention mechanism. The method takes the combination of log-Mel spectrogram and generalized cross-correlation phase transform ({GCC}-{PHAT}) as the input features, and extracts the time–frequency information by using the residual structure and channel attention mechanism, thus obtaining a better localizing performance. The residual blocks are introduced to extract deeper features, which can stack more layers for high-level features and avoid gradient vanishing or exploding at the same time. The attention mechanism is taken into account for the feature extraction stage in the proposed {SSL} model, which can focus on the most important information on the input features. We use the signals collected by microphone array to explore the performance of the model under different features, and find the most suitable input features of the proposed method. We compare our method with other models on public dataset. Experience results show a quite substantial improvement of sound source localizing performance.},
	pages = {5443},
	number = {1},
	journaltitle = {Scientific Reports},
	shortjournal = {Sci Rep},
	author = {Hu, Fucai and Song, Xiaohui and He, Ruhan and Yu, Yongsheng},
	urldate = {2023-10-23},
	date = {2023-04-03},
	langid = {english},
	note = {Number: 1
Publisher: Nature Publishing Group},
	keywords = {Computer science, Mathematics and computing},
	file = {Full Text PDF:/home/gaetan/.local/share/Zotero/storage/TDM3YNSS/Hu et al. - 2023 - Sound source localization based on residual networ.pdf:application/pdf},
}

@article{tan_sound_2021,
	title = {Sound Source Localization Using a Convolutional Neural Network and Regression Model},
	volume = {21},
	issn = {1424-8220},
	doi = {10.3390/s21238031},
	abstract = {In this research, a novel sound source localization model is introduced that integrates a convolutional neural network with a regression model ({CNN}-R) to estimate the sound source angle and distance based on the acoustic characteristics of the interaural phase difference ({IPD}). The {IPD} features of the sound signal are firstly extracted from time-frequency domain by short-time Fourier transform ({STFT}). Then, the {IPD} features map is fed to the {CNN}-R model as an image for sound source localization. The Pyroomacoustics platform and the multichannel impulse response database ({MIRD}) are used to generate both simulated and real room impulse response ({RIR}) datasets. The experimental results show that an average accuracy of 98.96\% and 98.31\% are achieved by the proposed {CNN}-R for angle and distance estimations in the simulation scenario at {SNR} = 30 {dB} and {RT}60 = 0.16 s, respectively. Moreover, in the real environment, the average accuracies of the angle and distance estimations are 99.85\% and 99.38\% at {SNR} = 30 {dB} and {RT}60 = 0.16 s, respectively. The performance obtained in both scenarios is superior to that of existing models, indicating the potential of the proposed {CNN}-R model for real-life applications.},
	pages = {8031},
	number = {23},
	journaltitle = {Sensors (Basel, Switzerland)},
	shortjournal = {Sensors (Basel)},
	author = {Tan, Tan-Hsu and Lin, Yu-Tang and Chang, Yang-Lang and Alkhaleefah, Mohammad},
	date = {2021-12-01},
	pmid = {34884042},
	pmcid = {PMC8659937},
	keywords = {deep learning, sound source localization, Computer Simulation, convolutional neural network, Databases, Factual, Neural Networks, Computer, regression model, Sound, man, printed},
	file = {Full Text:/home/gaetan/.local/share/Zotero/storage/ELSCM4ES/Tan et al. - 2021 - Sound Source Localization Using a Convolutional Ne.pdf:application/pdf},
}

@article{vera-diaz_towards_2018,
	title = {Towards End-to-End Acoustic Localization using Deep Learning: from Audio Signal to Source Position Coordinates},
	volume = {18},
	issn = {1424-8220},
	url = {http://arxiv.org/abs/1807.11094},
	doi = {10.3390/s18103418},
	shorttitle = {Towards End-to-End Acoustic Localization using Deep Learning},
	abstract = {This paper presents a novel approach for indoor acoustic source localization using microphone arrays and based on a Convolutional Neural Network ({CNN}). The proposed solution is, to the best of our knowledge, the ﬁrst published work in which the {CNN} is designed to directly estimate the three dimensional position of an acoustic source, using the raw audio signal as the input information avoiding the use of hand crafted audio features. Given the limited amount of available localization data, we propose in this paper a training strategy based on two steps. We ﬁrst train our network using semi-synthetic data, generated from close talk speech recordings, and where we simulate the time delays and distortion suffered in the signal that propagates from the source to the array of microphones. We then ﬁne tune this network using a small amount of real data. Our experimental results show that this strategy is able to produce networks that signiﬁcantly improve existing localization methods based on {SRP}-{PHAT} strategies. In addition, our experiments show that our {CNN} method exhibits better resistance against varying gender of the speaker and different window sizes compared with the other methods.},
	pages = {3418},
	number = {10},
	journaltitle = {Sensors},
	shortjournal = {Sensors},
	author = {Vera-Diaz, Juan Manuel and Pizarro, Daniel and Macias-Guarasa, Javier},
	urldate = {2022-06-20},
	date = {2018-10-12},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1807.11094 [cs, eess]},
	keywords = {Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Vera-Diaz et al. - 2018 - Towards End-to-End Acoustic Localization using Dee.pdf:/home/gaetan/.local/share/Zotero/storage/WLKPC778/Vera-Diaz et al. - 2018 - Towards End-to-End Acoustic Localization using Dee.pdf:application/pdf},
}

@misc{diaz-guerra_direction_2022,
	title = {Direction of Arrival Estimation of Sound Sources Using Icosahedral {CNNs}},
	url = {http://arxiv.org/abs/2203.16940},
	abstract = {In this paper, we present a new model for Direction of Arrival ({DOA}) estimation of sound sources based on an Icosahedral Convolutional Neural Network ({CNN}) applied over {SRP}-{PHAT} power maps computed from the signals received by a microphone array. This icosahedral {CNN} is equivariant to the 60 rotational symmetries of the icosahedron, which represent a good approximation of the continuous space of spherical rotations, and can be implemented using standard 2D convolutional layers, having a lower computational cost than most of the spherical {CNNs}. In addition, instead of using fully connected layers after the icosahedral convolutions, we propose a new soft-argmax function that can be seen as a differentiable version of the argmax function and allows us to solve the {DOA} estimation as a regression problem interpreting the output of the convolutional layers as a probability distribution. We prove that using models that ﬁt the equivariances of the problem allows us to outperform other state-of-the-art models with a lower computational cost and more robustness, obtaining root mean square localization errors lower than 10° even in scenarios with a reverberation time T60 of 1.5 s.},
	number = {{arXiv}:2203.16940},
	publisher = {{arXiv}},
	author = {Diaz-Guerra, David and Miguel, Antonio and Beltran, Jose R.},
	urldate = {2022-06-02},
	date = {2022-03-31},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2203.16940 [cs, eess]},
	note = {Number: {arXiv}:2203.16940},
	keywords = {Computer Science - Machine Learning, Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing, Electrical Engineering and Systems Science - Signal Processing},
	file = {Diaz-Guerra et al. - 2022 - Direction of Arrival Estimation of Sound Sources U.pdf:/home/gaetan/.local/share/Zotero/storage/CBZIXEPY/Diaz-Guerra et al. - 2022 - Direction of Arrival Estimation of Sound Sources U.pdf:application/pdf},
}

@article{diaz-guerra_robust_2021,
	title = {Robust Sound Source Tracking Using {SRP}-{PHAT} and 3D Convolutional Neural Networks},
	volume = {29},
	issn = {2329-9304},
	doi = {10.1109/TASLP.2020.3040031},
	abstract = {In this article, we present a new single sound source {DOA} estimation and tracking system based on the well-known {SRP}-{PHAT} algorithm and a three-dimensional Convolutional Neural Network. It uses {SRP}-{PHAT} power maps as input features of a fully convolutional causal architecture that uses 3D convolutional layers to accurately perform the tracking of a sound source even in highly reverberant scenarios where most of the state of the art techniques fail. Unlike previous methods, since we do not use bidirectional recurrent layers and all our convolutional layers are causal in the time dimension, our system is feasible for real-time applications and it provides a new {DOA} estimation for each new {SRP}-{PHAT} map. To train the model, we introduce a new procedure to simulate random trajectories as they are needed during the training, equivalent to an infinite-size dataset with high flexibility to modify its acoustical conditions such as the reverberation time. We use both acoustical simulations on a large range of reverberation times and the actual recordings of the {LOCATA} dataset to prove the robustness of our system and its good performance even using low-resolution {SRP}-{PHAT} maps.},
	pages = {300--311},
	journaltitle = {{IEEE}/{ACM} Transactions on Audio, Speech, and Language Processing},
	author = {Diaz-Guerra, D. and Miguel, A. and Beltran, J. R.},
	date = {2021},
	note = {Conference Name: {IEEE}/{ACM} Transactions on Audio, Speech, and Language Processing},
	keywords = {learning (artificial intelligence), Reverberation, Neural networks, 3D Convolutional Neural networks, acoustic generators, acoustic radiators, acoustic signal processing, bidirectional recurrent layers, {CNN}, convolutional layers, convolutional neural nets, convolutional neural networks, direction of arrival estimation, direction-of-arrival estimation, Direction-of-arrival estimation, {DOA}, Estimation, fully convolutional causal architecture, highly reverberant scenarios, low-resolution {SRP}-{PHAT} maps, microphone arrays, real-time applications, recurrent neural nets, reverberation, reverberation time, robust sound source tracking, Robustness, Search problems, simulate random trajectories, single sound source {DOA} estimation, sound source tracking, {SRP}-{PHAT}, {SRP}-{PHAT} algorithm, {SRP}-{PHAT} map, {SRP}-{PHAT} power maps, three-dimensional Convolutional Neural Network, Three-dimensional displays, time dimension, tracking system},
	file = {Diaz-Guerra et al_2021_Robust Sound Source Tracking Using SRP-PHAT and 3D Convolutional Neural Networks.pdf:/home/gaetan/.local/share/Zotero/storage/KVSALZ2D/Diaz-Guerra et al_2021_Robust Sound Source Tracking Using SRP-PHAT and 3D Convolutional Neural Networks.pdf:application/pdf;IEEE Xplore Abstract Record:/home/gaetan/.local/share/Zotero/storage/VDMRW8DK/9268154.html:text/html},
}


