@article{vera-diaz_towards_2018,
	title = {Towards End-to-End Acoustic Localization using Deep Learning: from Audio Signal to Source Position Coordinates},
	volume = {18},
	issn = {1424-8220},
	url = {http://arxiv.org/abs/1807.11094},
	doi = {10.3390/s18103418},
	shorttitle = {Towards End-to-End Acoustic Localization using Deep Learning},
	abstract = {This paper presents a novel approach for indoor acoustic source localization using microphone arrays and based on a Convolutional Neural Network ({CNN}). The proposed solution is, to the best of our knowledge, the ﬁrst published work in which the {CNN} is designed to directly estimate the three dimensional position of an acoustic source, using the raw audio signal as the input information avoiding the use of hand crafted audio features. Given the limited amount of available localization data, we propose in this paper a training strategy based on two steps. We ﬁrst train our network using semi-synthetic data, generated from close talk speech recordings, and where we simulate the time delays and distortion suffered in the signal that propagates from the source to the array of microphones. We then ﬁne tune this network using a small amount of real data. Our experimental results show that this strategy is able to produce networks that signiﬁcantly improve existing localization methods based on {SRP}-{PHAT} strategies. In addition, our experiments show that our {CNN} method exhibits better resistance against varying gender of the speaker and different window sizes compared with the other methods.},
	pages = {3418},
	number = {10},
	journaltitle = {Sensors},
	shortjournal = {Sensors},
	author = {Vera-Diaz, Juan Manuel and Pizarro, Daniel and Macias-Guarasa, Javier},
	urldate = {2022-06-20},
	date = {2018-10-12},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1807.11094 [cs, eess]},
	keywords = {Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Vera-Diaz et al. - 2018 - Towards End-to-End Acoustic Localization using Dee.pdf:/home/gaetan/.local/share/Zotero/storage/WLKPC778/Vera-Diaz et al. - 2018 - Towards End-to-End Acoustic Localization using Dee.pdf:application/pdf},
}

@misc{diaz-guerra_direction_2022,
	title = {Direction of Arrival Estimation of Sound Sources Using Icosahedral {CNNs}},
	url = {http://arxiv.org/abs/2203.16940},
	abstract = {In this paper, we present a new model for Direction of Arrival ({DOA}) estimation of sound sources based on an Icosahedral Convolutional Neural Network ({CNN}) applied over {SRP}-{PHAT} power maps computed from the signals received by a microphone array. This icosahedral {CNN} is equivariant to the 60 rotational symmetries of the icosahedron, which represent a good approximation of the continuous space of spherical rotations, and can be implemented using standard 2D convolutional layers, having a lower computational cost than most of the spherical {CNNs}. In addition, instead of using fully connected layers after the icosahedral convolutions, we propose a new soft-argmax function that can be seen as a differentiable version of the argmax function and allows us to solve the {DOA} estimation as a regression problem interpreting the output of the convolutional layers as a probability distribution. We prove that using models that ﬁt the equivariances of the problem allows us to outperform other state-of-the-art models with a lower computational cost and more robustness, obtaining root mean square localization errors lower than 10° even in scenarios with a reverberation time T60 of 1.5 s.},
	number = {{arXiv}:2203.16940},
	publisher = {{arXiv}},
	author = {Diaz-Guerra, David and Miguel, Antonio and Beltran, Jose R.},
	urldate = {2022-06-02},
	date = {2022-03-31},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2203.16940 [cs, eess]},
	note = {Number: {arXiv}:2203.16940},
	keywords = {Computer Science - Machine Learning, Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing, Electrical Engineering and Systems Science - Signal Processing},
	file = {Diaz-Guerra et al. - 2022 - Direction of Arrival Estimation of Sound Sources U.pdf:/home/gaetan/.local/share/Zotero/storage/CBZIXEPY/Diaz-Guerra et al. - 2022 - Direction of Arrival Estimation of Sound Sources U.pdf:application/pdf},
}

@article{diaz-guerra_robust_2021,
	title = {Robust Sound Source Tracking Using {SRP}-{PHAT} and 3D Convolutional Neural Networks},
	volume = {29},
	issn = {2329-9304},
	doi = {10.1109/TASLP.2020.3040031},
	abstract = {In this article, we present a new single sound source {DOA} estimation and tracking system based on the well-known {SRP}-{PHAT} algorithm and a three-dimensional Convolutional Neural Network. It uses {SRP}-{PHAT} power maps as input features of a fully convolutional causal architecture that uses 3D convolutional layers to accurately perform the tracking of a sound source even in highly reverberant scenarios where most of the state of the art techniques fail. Unlike previous methods, since we do not use bidirectional recurrent layers and all our convolutional layers are causal in the time dimension, our system is feasible for real-time applications and it provides a new {DOA} estimation for each new {SRP}-{PHAT} map. To train the model, we introduce a new procedure to simulate random trajectories as they are needed during the training, equivalent to an infinite-size dataset with high flexibility to modify its acoustical conditions such as the reverberation time. We use both acoustical simulations on a large range of reverberation times and the actual recordings of the {LOCATA} dataset to prove the robustness of our system and its good performance even using low-resolution {SRP}-{PHAT} maps.},
	pages = {300--311},
	journaltitle = {{IEEE}/{ACM} Transactions on Audio, Speech, and Language Processing},
	author = {Diaz-Guerra, D. and Miguel, A. and Beltran, J. R.},
	date = {2021},
	note = {Conference Name: {IEEE}/{ACM} Transactions on Audio, Speech, and Language Processing},
	keywords = {learning (artificial intelligence), Reverberation, Neural networks, 3D Convolutional Neural networks, acoustic generators, acoustic radiators, acoustic signal processing, bidirectional recurrent layers, {CNN}, convolutional layers, convolutional neural nets, convolutional neural networks, direction of arrival estimation, direction-of-arrival estimation, Direction-of-arrival estimation, {DOA}, Estimation, fully convolutional causal architecture, highly reverberant scenarios, low-resolution {SRP}-{PHAT} maps, microphone arrays, real-time applications, recurrent neural nets, reverberation, reverberation time, robust sound source tracking, Robustness, Search problems, simulate random trajectories, single sound source {DOA} estimation, sound source tracking, {SRP}-{PHAT}, {SRP}-{PHAT} algorithm, {SRP}-{PHAT} map, {SRP}-{PHAT} power maps, three-dimensional Convolutional Neural Network, Three-dimensional displays, time dimension, tracking system},
	file = {Diaz-Guerra et al_2021_Robust Sound Source Tracking Using SRP-PHAT and 3D Convolutional Neural Networks.pdf:/home/gaetan/.local/share/Zotero/storage/KVSALZ2D/Diaz-Guerra et al_2021_Robust Sound Source Tracking Using SRP-PHAT and 3D Convolutional Neural Networks.pdf:application/pdf;IEEE Xplore Abstract Record:/home/gaetan/.local/share/Zotero/storage/VDMRW8DK/9268154.html:text/html},
}


