	title = {Binaural source localization},
	abstract = {In binaural signals, interaural time differences ({ITDs}) and interaural level differences ({ILDs}) are two of the most important cues for the estimation of source azimuths, i.e. the localization of sources in the horizontal plane. For narrow band signals, according to the duplex theory, {ITD} is dominant at low frequencies and {ILD} is dominant at higher frequencies.},
