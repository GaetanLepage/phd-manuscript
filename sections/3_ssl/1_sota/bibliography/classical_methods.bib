	note = {Conference Name: {IEEE} Transactions on Antennas and Propagation},
	keywords = {Direction of arrival estimation, Frequency estimation, Interference, Multiple signal classification, Parameter estimation, Polarization, Sensor arrays, Sensor phenomena and characterization, Signal processing, Working environment noise},
	file = {Full Text PDF:/home/gaetan/.local/share/Zotero/storage/A7EP2JGY/Schmidt - 1986 - Multiple emitter location and signal parameter estimation.pdf:application/pdf},
}


