@inproceedings{flam_gaussian_2011,
	title = {Gaussian mixture modeling for source localization},
	url = {https://ieeexplore.ieee.org/abstract/document/5947018?utm_source=chatgpt.com},
	doi = {10.1109/ICASSP.2011.5947018},
	abstract = {Exploiting prior knowledge, we use Bayesian estimation to localize a source heard by a fixed sensor network. The method has two main aspects: Firstly, the probability density function ({PDF}) of a function of the source location is approximated by a Gaussian mixture model ({GMM}). This approximation can theoretically be made arbitrarily accurate, and allows a closed form minimum mean square error ({MMSE}) estimator for that function. Secondly, the source location is retrieved by minimizing the Euclidean distance between the function and its {MMSE} estimate using a gradient method. Our method avoids the issues of a numerical {MMSE} estimator but shows comparable accuracy.},
	eventtitle = {2011 {IEEE} International Conference on Acoustics, Speech and Signal Processing ({ICASSP})},
