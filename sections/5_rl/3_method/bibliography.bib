	langid = {english},
	eprinttype = {arxiv},
	eprint = {2106.04624},
	keywords = {Computer Science - Machine Learning, Computer Science - Artificial Intelligence, Computer Science - Sound, Electrical Engineering and Systems Science - Audio and Speech Processing},
	file = {Ravanelli et al. - 2021 - SpeechBrain A General-Purpose Speech Toolkit.pdf:/home/gaetan/.local/share/Zotero/storage/VSJTRBP3/Ravanelli et al. - 2021 - SpeechBrain A General-Purpose Speech Toolkit.pdf:application/pdf},
}

