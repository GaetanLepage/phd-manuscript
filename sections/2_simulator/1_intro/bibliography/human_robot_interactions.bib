	eprint = {2202.03582 [cs]},
	keywords = {Computer Science - Robotics},
	file = {PDF:/home/gaetan/.local/share/Zotero/storage/WDAHUIYY/Kaur et al. - 2022 - Simulators for Mobile Social RobotsState-of-the-Art and Challenges.pdf:application/pdf},
}