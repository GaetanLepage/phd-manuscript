	langid = {english},
	eprinttype = {arxiv},
	eprint = {1704.02532 [cs, stat]},
	keywords = {Computer Science - Machine Learning, Computer Science - Robotics, Statistics - Machine Learning},
	file = {Sallab et al. - 2017 - Deep Reinforcement Learning framework for Autonomo.pdf:/home/gaetan/.local/share/Zotero/storage/GXF7XAZE/Sallab et al. - 2017 - Deep Reinforcement Learning framework for Autonomo.pdf:application/pdf},
}


