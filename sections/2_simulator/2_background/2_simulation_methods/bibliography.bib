	note = {{ISSN}: 2076-1465},
	keywords = {acoustic simulation, Acoustics, Doppler effect, dynamic environment, Dynamics, Microphones, moving microphone, moving sound source, robot audition, Robots, robust automatic speech recognition, Signal processing, Trajectory},
