	number = {4},
	journaltitle = {The Journal of the Acoustical Society of America},
	shortjournal = {The Journal of the Acoustical Society of America},
	author = {Savioja, Lauri and Xiang, Ning},
	urldate = {2024-12-03},
	date = {2019-04-30},
