@article{savioja_introduction_2019,
	title = {Introduction to the Special Issue on Room Acoustic Modeling and Auralization},
	volume = {145},
	issn = {0001-4966},
	url = {https://doi.org/10.1121/1.5099017},
	doi = {10.1121/1.5099017},
	abstract = {This Special Issue on Room Acoustic Modeling and Auralization contains nineteen research papers. A majority of the papers focus on various room acoustic simulation techniques, while the remaining ones concentrate on auralization of either simulation or measurement results. Using room acoustic simulation, the last paper in this issue presents a case study of the historic venue, Palais du Trocadero in Paris, France.},
