@article{rathnayake_image_2019,
	title = {Image Source Method Based Acoustic Simulation For 3-D Room Environment},
	volume = {8},
	abstract = {Room Acoustics (also known as Architectural Acoustics or Building Acoustics) involves the scientific understanding of how to achieve a good sound quality within a building. The main purpose of this paper is to build a Room Acoustics Simulation which is capable: demonstrate visualization of sound propagation around 3-D virtual room environment, examine the Room Impulse Response ({RIR}) and perform a less computational cost audio demonstration to understand the behavior of reverberation and echo effect. Furthermore, this paper proposes a new method to obtain the {RIR} for a given receiver point. In this paper, Image-Source Method ({ISM}) use as a modeling method for this acoustic simulation. Since all the previous works about {ISM} are done for 2-D room environments, this paper could be the first to implement {ISM} for 3-D virtual room environment.},
	pages = {222--228},
	journaltitle = {International Journal of Scientific \& Technology Research},
	shortjournal = {International Journal of Scientific \& Technology Research},
	author = {Rathnayake, Anjana and Wanniarachchi, W. K.},
	date = {2019-11-01},
	file = {Full Text PDF:/home/gaetan/.local/share/Zotero/storage/CZ93X4ZP/Rathnayake and Wanniarachchi - 2019 - Image Source Method Based Acoustic Simulation For 3-D Room Environment.pdf:application/pdf},
}